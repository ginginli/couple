# ---- Provider keys（服务端专用，绝不要放进前端）----
FAL_KEY=                 # fal.ai  → https://fal.ai/dashboard/keys
ATLAS_KEY=               # Atlas Cloud → https://www.atlascloud.ai

# ---- 可选：模型 id 覆盖（目录 id 变动时用）----
# FAL_MODEL_KLING_R2V=fal-ai/kling-video/o3/standard/reference-to-video
# FAL_MODEL_SEEDANCE=bytedance/seedance-v2.5-text-ref
# ATLAS_MODEL_KLING_R2V=kwaivgi/kling-video-o3-std/reference-to-video
# ATLAS_MODEL_SEEDANCE=bytedance/seedance-v2.5-text-ref

# ---- 可选：Atlas 路径覆盖（已校准）----
# ATLAS_BASE=https://api.atlascloud.ai/api/v1
# ATLAS_SUBMIT_PATH=/video/generations
# ATLAS_STATUS_PATH=/generations

# ---- 图片上传存储（/api/ai/uploads 用）----
# 推荐 Vercel Blob：项目里开通 Blob 后会自动注入，不用手填
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
# STORAGE_BACKEND=blob        # blob | datauri（datauri 仅本地自测，多数厂商不接受）
# UPLOAD_PREFIX=uploads

# ---- 通道顺序（主 → 备）----
VIDEO_PROVIDER_CHAIN=fal,atlas

# ---- 内部签名密钥（/api/ai/status 用）----
INTERNAL_SECRET=change-me

# ---- 账户体系（Google 一键登录）----
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# 授权来源填 https://zombie-couple.xyz 与 http://localhost:3000
GOOGLE_CLIENT_ID=
# 会话签名密钥：openssl rand -hex 32
SESSION_SECRET=

# ---- 收款（Creem）----
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_STARTER=prod_6bLz4OmyOU04TeC3hamJg2   # 2,000 积分 / $9.90
CREEM_PRODUCT_POPULAR=prod_1h7o5SO8lfqcV8U3sC2Vgy   # 3,000 积分 / $12.90
CREEM_PRODUCT_PRO=prod_7WNswNToyQtlscQkdCw6Kp    # 20,000 积分 / $99.00
# 只填 product id 也能收款：支付地址 = https://www.creem.io/payment/<product_id>
# 此时靠付款邮箱反查用户入账（买家必须用登录时的同一个邮箱付款）
# 填了 CREEM_API_KEY 则走动态结账，可携带 userId，入账更可靠
# CREEM_TEST=1

# ---- 后台补发（邮箱匹配不到用户时人工兜底）----
# 生成：openssl rand -hex 24
ADMIN_TOKEN=
# 查待认领：curl -H "x-admin-token: $ADMIN_TOKEN" https://zombie-couple.xyz/api/admin/grant
# 补发积分：curl -X POST -H "x-admin-token: $ADMIN_TOKEN" -H "Content-Type: application/json" \
#   -d '{"email":"buyer@example.com","credits":3000,"note":"manual"}' \
#   https://zombie-couple.xyz/api/admin/grant
# Webhook 地址填：https://zombie-couple.xyz/api/billing/webhook

# ---- 视频生成 provider（单一通道，不做降级）----
# fal | atlas ；不填时按“配了哪个 key 就用哪个”（有 ATLAS_KEY 则 atlas）
VIDEO_PROVIDER=atlas
# 注意：Atlas 的 Kling O3 Standard 输出固定 720P，接口无 resolution 参数

# ---- 档位 → Atlas 模型（Atlas 的 Kling 输出分辨率固定，只能靠换模型区分画质）----
# 默认：480p/720p = Kling O3 Std（720P 固定）；1080p = Kling O3 Pro（1080P 固定）
# ATLAS_MODEL_480P=xai/grok-imagine-video/reference-to-video   # 真 480p，但最长 10 秒且无音频
# ATLAS_MODEL_720P=kwaivgi/kling-video-o3-std/reference-to-video
# ATLAS_MODEL_1080P=kwaivgi/kling-video-o3-pro/reference-to-video
