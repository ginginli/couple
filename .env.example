# ---- Provider keys（服务端专用，绝不要放进前端）----
FAL_KEY=                 # fal.ai  → https://fal.ai/dashboard/keys
ATLAS_KEY=               # Atlas Cloud → https://www.atlascloud.ai

# ---- 可选：模型 id 覆盖（目录 id 变动时用）----
# FAL_MODEL_KLING_R2V=fal-ai/kling-video/o3/standard/reference-to-video
# FAL_MODEL_SEEDANCE=bytedance/seedance-v2.5-text-ref
# ATLAS_MODEL_KLING_R2V=kwaivgi/kling-video-o3-std/reference-to-video
# ATLAS_MODEL_SEEDANCE=bytedance/seedance-v2.5-text-ref

# ---- 可选：Atlas 路径覆盖（跑 selftest 后按真实返回校准）----
# ATLAS_BASE=https://api.atlascloud.ai/v1
# ATLAS_SUBMIT_PATH=/video/generations
# ATLAS_STATUS_PATH=/generations

# ---- 通道顺序（主 → 备）----
VIDEO_PROVIDER_CHAIN=fal,atlas

# ---- 内部签名密钥（/api/ai/status 用）----
INTERNAL_SECRET=change-me
